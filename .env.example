# Local shared demo. No LLM or API key required.
ENVIRONMENT=development
DEMO_MODE=true
AI_PROVIDER=none
LLM_TIMEOUT_SECONDS=8
NETWORK_SCANNERS_ENABLED=false
DATABASE_URL=sqlite:///./fake_or_real.db
REDIS_URL=redis://localhost:6379/0
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Generate your own stable random secret for real accounts. In local development,
# an empty value generates an ephemeral secret and tokens expire on server restart.
JWT_SECRET=
# Production requires ENVIRONMENT=production, DEMO_MODE=false and a unique secret
# of at least 32 characters. Configure trusted origins explicitly; '*' is rejected.

# Optional server-side research; never put a key in a VITE_ variable.
TAVILY_API_KEY=
RESEARCH_TIMEOUT_SECONDS=8
SAFE_BROWSING_API_KEY=
# Adapters below are retained placeholders and report UNAVAILABLE.
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# Docker Compose only: set these before running compose.
POSTGRES_USER=fakeorreal_user
POSTGRES_PASSWORD=
POSTGRES_DB=fakeorreal_db
# For PostgreSQL use postgresql+psycopg://user:password@host/database

# Frontend only: set inside frontend/.env.local when using a different backend.
# VITE_API_BASE=http://localhost:8000/api
# Gemma/Ollama/provider-specific setup is intentionally deferred.
