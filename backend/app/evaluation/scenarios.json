{
  "name": "Synthetic opportunity integrity benchmark",
  "version": 1,
  "synthetic": true,
  "purpose": "Regression evaluation of extraction and concern/abstention policy, not real-world fraud accuracy. Labels are observable concern expectations, not authenticity ground truth.",
  "scenarios": [
    {
      "id": "poster-aexon",
      "synthetic": true,
      "category": "unverified_poster",
      "description": "unverified poster",
      "sources": [
        {
          "input_type": "text",
          "title": "Synthetic source",
          "content": "AEXON TECH\nINTERNSHIP PROGRAM\nRole: Software engineering intern\nStipend INR 15,000 per month.\nDuration: 3 months"
        }
      ],
      "expected": {
        "state": "UNDETERMINED",
        "claims": [
          {
            "type": "organization",
            "value": "AEXON TECH"
          },
          {
            "type": "compensation",
            "value": {
              "value": "15000",
              "currency": "INR",
              "category": "STIPEND",
              "period": "month"
            }
          }
        ],
        "extraction_scope": [
          "compensation",
          "organization"
        ]
      },
      "challenge": "A"
    },
    {
      "id": "stipend-fee",
      "synthetic": true,
      "category": "mixed_amounts",
      "description": "mixed amounts",
      "sources": [
        {
          "input_type": "text",
          "title": "Synthetic source",
          "content": "AEXON TECH\nSoftware engineering internship. Your stipend will be ₹45,000 per month. To confirm your position, pay a refundable registration fee of ₹999."
        }
      ],
      "expected": {
        "state": "ELEVATED_CONCERN",
        "claims": [
          {
            "type": "organization",
            "value": "AEXON TECH"
          },
          {
            "type": "compensation",
            "value": {
              "value": "45000",
              "currency": "INR",
              "category": "STIPEND",
              "period": "month"
            }
          },
          {
            "type": "fee",
            "value": {
              "value": "999",
              "currency": "INR",
              "category": "REGISTRATION_FEE",
              "period": null
            }
          }
        ],
        "extraction_scope": [
          "compensation",
          "fee",
          "organization"
        ]
      },
      "challenge": "B"
    },
    {
      "id": "stipend-conflict",
      "synthetic": true,
      "category": "cross_source",
      "description": "cross source",
