          "content": "Company: AEXON TECH\nInternship stipend INR 15,000 per month."
        },
        {
          "input_type": "text",
          "title": "Synthetic recruiter message",
          "content": "Company: AEXON TECH\nInternship stipend INR 25,000 per month."
        }
      ],
      "expected": {
        "state": "ELEVATED_CONCERN",
        "claims": [
          {
            "type": "compensation",
            "value": {
              "value": "15000",
              "currency": "INR",
              "category": "STIPEND",
              "period": "month"
            }
          },
          {
            "type": "compensation",
            "value": {
              "value": "25000",
              "currency": "INR",
              "category": "STIPEND",
              "period": "month"
            }
          }
        ],
        "extraction_scope": [
          "compensation"
        ],
        "cross_kind": "COMPENSATION_CONFLICT"
